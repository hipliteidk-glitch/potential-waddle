{
  "_readme": [
    "Ready-to-use ZeroScript config for Termux on Android. No MCP, no Roblox.",
    "Copy it over config.json:   cp config.termux.json config.json",
    "",
    "It gives the AI read/write access to ONE folder: ~/zs (created by",
    "start-termux.sh). Change {path} defaults or add tools as you like.",
    "To reach your real phone storage, run `termux-setup-storage` once, then",
    "point cwd at /data/data/com.termux/files/home/storage/shared.",
    "",
    "Every 'run' is an argv LIST executed WITHOUT a shell, so an argument can",
    "never start a second command. See NO-MCP.md."
  ],
  "target": {
    "id": "phone",
    "kind": "generic",
    "name": "my phone",
    "short": "Phone",
    "offline_hint": "Make sure the bridge is running in Termux (bash start-termux.sh)."
  },
  "servers": {
    "phone": {
      "type": "script",
      "tools": [
        {
          "name": "list_files",
          "description": "List the files in a folder inside the workspace. Use '.' for the top level.",
          "params": {
            "path": {
              "type": "string",
              "description": "folder, relative to the workspace",
              "default": "."
            }
          },
          "cwd": "{ZS_WORKSPACE}",
          "run": [
            "ls",
            "-la",
            "{path}"
          ]
        },
        {
          "name": "read_file",
          "description": "Show the full contents of a text file.",
          "params": {
            "path": {
              "type": "string",
              "description": "file to read",
              "required": true
            }
          },
          "cwd": "{ZS_WORKSPACE}",
          "run": [
            "cat",
            "{path}"
          ]
        },
        {
          "name": "write_file",
          "description": "Create or overwrite a text file with the given content.",
          "params": {
            "path": {
              "type": "string",
              "description": "file to write",
              "required": true
            },
            "content": {
              "type": "string",
              "description": "the full text to put in the file",
              "required": true
            }
          },
          "cwd": "{ZS_WORKSPACE}",
          "run": [
            "python",
            "-c",
            "import sys,pathlib;p=pathlib.Path(sys.argv[1]);p.parent.mkdir(parents=True,exist_ok=True);p.write_text(sys.argv[2]);print(f'wrote {len(sys.argv[2])} chars to {p}')",
            "{path}",
            "{content}"
          ]
        },
        {
          "name": "append_file",
          "description": "Append a line of text to the end of a file.",
          "params": {
            "path": {
              "type": "string",
              "description": "file to append to",
              "required": true
            },
            "content": {
              "type": "string",
              "description": "text to append",
              "required": true
            }
          },
          "cwd": "{ZS_WORKSPACE}",
          "run": [
            "python",
            "-c",
            "import sys,pathlib;p=pathlib.Path(sys.argv[1]);p.parent.mkdir(parents=True,exist_ok=True);f=p.open('a');f.write(sys.argv[2]+chr(10));f.close();print('appended to '+str(p))",
            "{path}",
            "{content}"
          ]
        },
        {
          "name": "search_text",
          "description": "Search for a text pattern in the workspace and show matching lines with line numbers.",
          "params": {
            "pattern": {
              "type": "string",
              "description": "text to look for",
              "required": true
            },
            "path": {
              "type": "string",
              "description": "folder or file to search; defaults to everything",
              "default": "."
            }
          },
          "cwd": "{ZS_WORKSPACE}",
          "run": [
            "grep",
            "-rn",
            "--",
            "{pattern}",
            "{path}"
          ]
        },
        {
          "name": "delete_file",
          "description": "Delete ONE file. Destructive - confirm with the user first.",
          "params": {
            "path": {
              "type": "string",
              "description": "file to delete",
              "required": true
            }
          },
          "cwd": "{ZS_WORKSPACE}",
          "run": [
            "rm",
            "-v",
            "--",
            "{path}"
          ]
        },
        {
          "name": "phone_status",
          "description": "Show free space and the current date on the phone.",
          "cwd": "{ZS_WORKSPACE}",
          "run": [
            "sh",
            "-c",
            "date; echo; df -h ."
          ]
        }
      ]
    }
  }
}